#!/bin/bash
#SBATCH --nodes=1
#SBATCH --gpus=1
#SBATCH --partition=gpu_a100
#SBATCH --time=05:00:00
#SBATCH --cpus-per-task=8
#SBATCH --job-name=train_mlp
#SBATCH --output=logs/%x/%j.out

module purge
module load 2024
module load Anaconda3/2024.06-1

cd ~/banyan

source activate banyan2

# MLP merge scoring (learned) - replaces fixed cosine similarity
python src/train.py \
  --scoring mlp \
  --save_path checkpoints/en_mlp.pt
