#!/bin/bash
#SBATCH --nodes=1
#SBATCH --gpus=1
#SBATCH --partition=gpu_a100
#SBATCH --time=05:00:00
#SBATCH --cpus-per-task=8
#SBATCH --job-name=finetune_full
#SBATCH --output=logs/%x/%j.out

module purge
module load 2024
module load Anaconda3/2024.06-1

cd ~/Repo_Combined/banyan
source activate banyan

# Full fine-tuning: train everything with contrastive + reconstruction loss
python src/train_retrieval.py \
    --pretrained_path checkpoints/en.pt \
    --train_path data/msmarco/prepared_data/train.jsonl \
    --dev_path data/msmarco/prepared_data/val.jsonl \
    --use_projection \
    --projection_dim 128 \
    --recon_weight 0.5 \
    --temperature 0.05 \
    --batch_size 64 \
    --max_query_len 32 \
    --max_passage_len 200 \
    --num_workers 4 \
    --lr 1e-5 \
    --weight_decay 0.01 \
    --epochs 3 \
    --save_path checkpoints/banyan_retrieval_full.pt \
    --seed 42